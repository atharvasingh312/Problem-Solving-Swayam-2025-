class TreeAncestor {
public:
    vector<vector<int>> dp;
    TreeAncestor(int n, vector<int>& parent) {
        int j=log2(n)+1;
        dp.resize(n,vector<int>(j,INT_MIN));
        for(int i=0;i<parent.size();i++){
            dp[i][0]=parent[i];
        }
    }

    int getJump(int node,int x){
        if(x==0) return dp[node][x];
        else if(dp[node][x]!=INT_MIN) return dp[node][x];
        int half=getJump(node,x-1);
        if(half==-1) return -1;
        return dp[node][x]=getJump(half,x-1);
    }
    
    int getKthAncestor(int node, int k) {
        int curr=node;
        for(int i=0;i<32;i++){
            if((k>>i)&1){
                if(curr==-1) return -1;
                curr=getJump(curr,i);
            }
        }
        return curr;
    }
};

